import React, { useState } from 'react';
import { Loader2 } from 'lucide-react';

export default function AssetFlowAuth() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState('');

  const handleSubmit = async (e, action) => {
    e.preventDefault();
    setError('');
    
    // Basic validation
    if (!email && action === 'login') {
      setError('Please enter your email address.');
      return;
    }
    if ((!email || !password) && action === 'login') {
      setError('Please fill in all fields to sign in.');
      return;
    }

    setIsLoading(true);

    // Simulate API call for demonstration
    try {
      await new Promise(resolve => setTimeout(resolve, 800));
      if (action === 'login') {
        if (email === 'admin@company.com' && password === 'password') {
          // Success case
          alert('Login successful! Proceeding to Dashboard...');
        } else {
          throw new Error('Invalid credentials. Try admin@company.com / password');
        }
      } else if (action === 'signup') {
        alert('Account created! Employee role assigned pending admin approval.');
      }
    } catch (err) {
      setError(err.message);
    } finally {
      setIsLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 flex items-center justify-center p-4 font-sans text-gray-800 selection:bg-gray-200">
      
      {/* Main Card Container */}
      <div className="w-full max-w-[380px] rounded-2xl border border-gray-200 bg-white shadow-xl relative overflow-hidden">
        
        {/* Loading overlay for optimistic UI */}
        {isLoading && (
          <div className="absolute inset-0 bg-white/80 backdrop-blur-sm z-10 flex items-center justify-center">
            <Loader2 className="w-8 h-8 text-gray-500 animate-spin" />
          </div>
        )}

        {/* Header Section */}
        <div className="px-6 py-5 border-b border-gray-200 text-center bg-white">
          <h1 className="text-base font-semibold text-gray-900 tracking-wide flex items-center justify-center gap-1.5">
            AssetFlow <span className="text-gray-500 font-normal">| login</span>
          </h1>
        </div>

        <div className="p-6 sm:p-8">
          
          {/* Circular Logo Marker */}
          <div className="flex justify-center mb-8">
            <div className="w-12 h-12 rounded-full border border-gray-300 flex items-center justify-center bg-gray-50 shadow-sm">
              <span className="text-gray-700 text-sm font-semibold tracking-wider">AF</span>
            </div>
          </div>

          {/* Primary Login Form */}
          <form className="space-y-4" onSubmit={(e) => handleSubmit(e, 'login')}>
            
            {/* Inline Error Display */}
            {error && (
              <div className="px-3 py-2 border border-red-200 bg-red-50 rounded-lg text-red-600 text-xs mb-4 text-center">
                {error}
              </div>
            )}

            {/* Email Input Group */}
            <div className="space-y-1.5">
              <label className="block text-xs font-semibold text-gray-600">
                Email
              </label>
              <input
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                placeholder="name@company.com"
                className="w-full bg-white border border-gray-300 rounded-lg px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 transition-shadow"
                autoComplete="email"
                required
              />
            </div>

            {/* Password Input Group */}
            <div className="space-y-1.5">
              <label className="block text-xs font-semibold text-gray-600">
                Password
              </label>
              <input
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                placeholder="••••••••"
                className="w-full bg-white border border-gray-300 rounded-lg px-3.5 py-2.5 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-gray-500 focus:ring-1 focus:ring-gray-500 transition-shadow"
                autoComplete="current-password"
                required
              />
              <div className="flex justify-end pt-1">
                <button type="button" className="text-xs text-gray-500 hover:text-gray-800 font-medium transition-colors">
                  Forgot password
                </button>
              </div>
            </div>

            {/* Invisible submit button to allow Enter key to work cleanly */}
            <button type="submit" className="hidden">Submit</button>
          </form>

          {/* Divider */}
          <div className="my-8 relative">
            <div className="absolute inset-0 flex items-center">
              <div className="w-full border-t border-gray-200"></div>
            </div>
          </div>

          {/* New User / Signup Section */}
          <div className="space-y-3">
            <p className="text-sm text-gray-800 font-semibold">New here?</p>
            
            <div className="border border-gray-200 rounded-lg p-3 bg-gray-50">
              <p className="text-xs text-gray-600 leading-relaxed">
                Sign up creates an employee account — admin roles assigned later
              </p>
            </div>

            <button 
              onClick={(e) => { e.preventDefault(); handleSubmit(e, 'signup'); }}
              type="button"
              className="w-full mt-2 border border-gray-300 hover:border-gray-400 bg-white hover:bg-gray-50 rounded-lg py-2.5 text-sm font-semibold text-gray-700 transition-all shadow-sm active:scale-[0.98]"
            >
              Create Account
            </button>
          </div>

        </div>
      </div>
    </div>
  );
}
