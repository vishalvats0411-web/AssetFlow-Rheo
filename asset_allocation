const ResourceBooking = () => {
  const { user } = useContext(AppContext);
  const resources = mockDB.assets.filter(a => a.isBookable);
  const [selectedResId, setSelectedResId] = useState(resources[0]?.id || '');
  const [newBooking, setNewBooking] = useState({ start: 9, end: 10 }); // hours 9-17
  const [conflict, setConflict] = useState(false);
  const [bookings, setBookings] = useState(mockDB.bookings); // local state for reactivity

  const resourceBookings = bookings.filter(b => b.assetId === parseInt(selectedResId));

  // CORE RULE: BOOKING OVERLAP VALIDATION
  useEffect(() => {
    let hasConflict = false;
    for (let b of resourceBookings) {
      const bStart = parseInt(b.start.split(':')[0]);
      const bEnd = parseInt(b.end.split(':')[0]);
      // Overlap formula: newStart < existingEnd AND newEnd > existingStart
      if (newBooking.start < bEnd && newBooking.end > bStart) {
        hasConflict = true;
        break;
      }
    }
    setConflict(hasConflict);
  }, [newBooking, selectedResId, bookings, resourceBookings]);

  const handleBook = () => {
    if (conflict) return;
    const newB = {
      id: generateId(),
      assetId: parseInt(selectedResId),
      bookedById: user.id,
      start: `${newBooking.start}:00`,
      end: `${newBooking.end}:00`,
      date: '2023-10-26', // Mock fixed date for demo
      status: 'Upcoming'
    };
    mockDB.bookings.push(newB);
    setBookings([...mockDB.bookings]);
    logActivity(`Resource booked: ${resources.find(r=>r.id===parseInt(selectedResId)).name}`);
  };

  const hours = Array.from({length: 9}, (_, i) => i + 9); // 9 AM to 5 PM

  return (
    <div className="space-y-6">
      <h2 className="text-2xl font-bold text-gray-900">Resource Booking</h2>
      
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <Card className="p-6 col-span-1 space-y-6 h-fit">
          <Select 
            label="Select Resource"
            options={resources.map(r => ({label: r.name, value: r.id}))}
            value={selectedResId}
            onChange={(e) => setSelectedResId(e.target.value)}
          />

          <div className="space-y-4 pt-4 border-t">
            <h4 className="font-medium text-gray-900">New Booking</h4>
            <div className="grid grid-cols-2 gap-4">
              <Select 
                label="Start Time"
                options={hours.map(h => ({label: `${h}:00`, value: h}))}
                value={newBooking.start}
                onChange={(e) => setNewBooking({...newBooking, start: parseInt(e.target.value)})}
              />
              <Select 
                label="End Time"
                options={hours.map(h => ({label: `${h}:00`, value: h}))}
                value={newBooking.end}
                onChange={(e) => setNewBooking({...newBooking, end: parseInt(e.target.value)})}
              />
            </div>
            
            {conflict && (
              <div className="p-3 bg-red-50 text-red-700 text-sm rounded-md border border-red-200 flex items-start">
                <AlertCircle className="w-4 h-4 mr-2 mt-0.5 flex-shrink-0" />
                Requested time slot conflicts with an existing booking.
              </div>
            )}

            <Button className="w-full" disabled={conflict || newBooking.start >= newBooking.end} onClick={handleBook}>
              Confirm Booking
            </Button>
          </div>
        </Card>

        <Card className="p-6 col-span-2">
          <div className="flex justify-between items-center mb-6">
            <h3 className="text-lg font-medium text-gray-900">Today's Schedule</h3>
            <div className="text-sm text-gray-500 flex items-center"><CalendarIcon className="w-4 h-4 mr-2"/> Oct 26, 2023</div>
          </div>
          
          {/* Simple Timeline View */}
          <div className="relative border-l-2 border-gray-100 ml-4 pl-4 space-y-8 py-4">
            {hours.slice(0,-1).map(hour => {
              // Check if there's a booking starting at this hour
              const b = resourceBookings.find(b => parseInt(b.start) === hour);
              // Check if current new booking attempt overlaps this block for visualization
              const isOverlapAttempt = conflict && (newBooking.start <= hour && newBooking.end > hour);

              return (
                <div key={hour} className="relative flex items-center">
                  <div className="absolute -left-[25px] bg-white text-xs text-gray-400 py-1">{hour}:00</div>
                  <div className="w-full border-t border-gray-100 absolute top-1/2 -z-10"></div>
                  
                  {b ? (
                    <div className="ml-8 bg-indigo-100 border border-indigo-200 text-indigo-800 px-4 py-2 rounded-md w-full shadow-sm">
                      <p className="text-sm font-medium">Booked by {mockDB.users.find(u=>u.id === b.bookedById)?.name}</p>
                      <p className="text-xs text-indigo-600">{b.start} - {b.end}</p>
                    </div>
                  ) : isOverlapAttempt ? (
                     <div className="ml-8 bg-red-50 border-2 border-dashed border-red-300 text-red-700 px-4 py-2 rounded-md w-full opacity-70">
                       <p className="text-sm font-medium">Conflict - Unavailable</p>
                     </div>
                  ) : (
                    <div className="ml-8 h-10 w-full hover:bg-gray-50 rounded-md transition-colors border border-transparent hover:border-gray-100 group flex items-center justify-center cursor-pointer" onClick={() => setNewBooking({start: hour, end: hour+1})}>
                      <span className="text-xs text-gray-400 opacity-0 group-hover:opacity-100">Click to select</span>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </Card>
      </div>
    </div>
  );
};

const MaintenanceBoard = () => {
  const [requests, setRequests] = useState(mockDB.maintenance);
  const columns = ['Pending', 'Approved', 'In Progress', 'Resolved'];

  const moveRequest = (reqId, newStatus) => {
    const updated = requests.map(r => r.id === reqId ? { ...r, status: newStatus } : r);
    setRequests(updated);
    mockDB.maintenance = updated;
    logActivity(`Maintenance request ${reqId} moved to ${newStatus}`);

    // CORE RULE: Maintenance status sync
    if (newStatus === 'Approved' || newStatus === 'In Progress') {
      const req = updated.find(r => r.id === reqId);
      const assetIdx = mockDB.assets.findIndex(a => a.id === req.assetId);
      if(assetIdx > -1) mockDB.assets[assetIdx].status = STATUSES.MAINTENANCE;
    } else if (newStatus === 'Resolved') {
       const req = updated.find(r => r.id === reqId);
       const assetIdx = mockDB.assets.findIndex(a => a.id === req.assetId);
       if(assetIdx > -1) mockDB.assets[assetIdx].status = STATUSES.AVAILABLE;
    }
  };

  return (
    <div className="space-y-6 h-full flex flex-col">
      <div className="flex justify-between items-center">
        <h2 className="text-2xl font-bold text-gray-900">Maintenance Pipeline</h2>
        <Button><Plus className="w-4 h-4 mr-2"/> Raise Request</Button>
      </div>

      <div className="flex-1 grid grid-cols-1 md:grid-cols-4 gap-6 overflow-x-auto pb-4">
        {columns.map(col => (
          <div key={col} className="bg-gray-50 rounded-lg p-4 min-w-[280px] flex flex-col">
            <div className="flex items-center justify-between mb-4">
              <h3 className="font-semibold text-gray-700">{col}</h3>
              <span className="bg-gray-200 text-gray-600 py-0.5 px-2 rounded-full text-xs font-medium">
                {requests.filter(r => r.status === col).length}
              </span>
            </div>
            
            <div className="space-y-3 flex-1">
              {requests.filter(r => r.status === col).map(req => {
                const asset = mockDB.assets.find(a => a.id === req.assetId);
                return (
                  <div key={req.id} className="bg-white p-4 rounded-md shadow-sm border border-gray-200 cursor-default hover:shadow-md transition-shadow">
                    <div className="flex justify-between items-start mb-2">
                      <span className="text-xs font-medium text-indigo-600 bg-indigo-50 px-2 py-1 rounded">{asset?.tag}</span>
                      <span className={`text-[10px] uppercase font-bold px-1.5 py-0.5 rounded ${req.priority === 'High' ? 'bg-red-100 text-red-700' : 'bg-gray-100 text-gray-600'}`}>
                        {req.priority}
                      </span>
                    </div>
                    <p className="text-sm text-gray-900 font-medium mb-3">{req.issue}</p>
                    
                    {/* Action Buttons to simulate moving across pipeline */}
                    <div className="flex space-x-2 border-t pt-3 mt-2">
                      {col === 'Pending' && <Button variant="ghost" className="w-full text-xs bg-indigo-50 text-indigo-700" onClick={() => moveRequest(req.id, 'Approved')}>Approve</Button>}
                      {col === 'Approved' && <Button variant="ghost" className="w-full text-xs bg-blue-50 text-blue-700" onClick={() => moveRequest(req.id, 'In Progress')}>Assign Tech</Button>}
                      {col === 'In Progress' && <Button variant="ghost" className="w-full text-xs bg-green-50 text-green-700" onClick={() => moveRequest(req.id, 'Resolved')}>Resolve</Button>}
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
};

