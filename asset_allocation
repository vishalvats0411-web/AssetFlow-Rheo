const AllocationTransfer = () => {
  const [selectedAssetId, setSelectedAssetId] = useState('');
  const [selectedAsset, setSelectedAsset] = useState(null);
  const [transferTo, setTransferTo] = useState('');
  const [reason, setReason] = useState('');
  const [message, setMessage] = useState(null); // {type: 'error'|'success', text: ''}

  useEffect(() => {
    if (selectedAssetId) {
      setSelectedAsset(mockDB.assets.find(a => a.id === parseInt(selectedAssetId)));
      setMessage(null);
    }
  }, [selectedAssetId]);

  const handleAction = () => {
    if (!selectedAsset || !transferTo) return;

    if (selectedAsset.status === STATUSES.ALLOCATED) {
      // Simulate Transfer Request
      setMessage({ type: 'success', text: 'Transfer request submitted for approval.' });
      logActivity(`Transfer request submitted for ${selectedAsset.tag}`);
    } else {
      // Simulate Direct Allocation
      const updatedAsset = { ...selectedAsset, status: STATUSES.ALLOCATED, currentHolderId: parseInt(transferTo) };
      const idx = mockDB.assets.findIndex(a => a.id === selectedAsset.id);
      mockDB.assets[idx] = updatedAsset;
      mockDB.allocations.push({ id: generateId(), assetId: selectedAsset.id, holderId: parseInt(transferTo), status: 'Active', date: new Date().toISOString() });
      setSelectedAsset(updatedAsset);
      setMessage({ type: 'success', text: 'Asset allocated successfully.' });
      logActivity(`Asset ${selectedAsset.tag} allocated to user ID ${transferTo}`);
    }
  };

  return (
    <div className="space-y-6">
      <h2 className="text-2xl font-bold text-gray-900">Allocation & Transfer</h2>
      
      <Card className="p-6">
        <div className="max-w-2xl space-y-6">
          <Select 
            label="Select Asset to Manage"
            options={[{label: '-- Select an Asset --', value: ''}, ...mockDB.assets.filter(a => !a.isBookable).map(a => ({label: `${a.tag} - ${a.name}`, value: a.id}))]}
            value={selectedAssetId}
            onChange={(e) => setSelectedAssetId(e.target.value)}
          />

          {selectedAsset && (
            <div className="mt-6 border-t pt-6 space-y-6">
              {/* CORE RULE: DOUBLE ALLOCATION BLOCK UI */}
              {selectedAsset.status === STATUSES.ALLOCATED && (
                <div className="bg-red-50 border border-red-200 p-4 rounded-md flex items-start">
                  <ShieldAlert className="text-red-600 w-5 h-5 mr-3 mt-0.5" />
                  <div>
                    <h3 className="text-sm font-medium text-red-800">Direct Allocation Blocked</h3>
                    <p className="text-sm text-red-700 mt-1">
                      This asset is currently allocated to {mockDB.users.find(u=>u.id === selectedAsset.currentHolderId)?.name}. 
                      Submit a transfer request below instead.
                    </p>
                  </div>
                </div>
              )}

              {message && (
                <div className={`p-4 rounded-md text-sm ${message.type === 'error' ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700'}`}>
                  {message.text}
                </div>
              )}

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                <Select 
                  label={selectedAsset.status === STATUSES.ALLOCATED ? "Transfer To (Employee)" : "Allocate To (Employee)"}
                  options={[{label: '-- Select Employee --', value: ''}, ...mockDB.users.map(u => ({label: u.name, value: u.id}))]}
                  value={transferTo}
                  onChange={(e) => setTransferTo(e.target.value)}
                />
              </div>

              {selectedAsset.status === STATUSES.ALLOCATED && (
                <div className="space-y-1">
                  <label className="block text-sm font-medium text-gray-700">Reason for Transfer</label>
                  <textarea 
                    className="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" 
                    rows="3"
                    value={reason}
                    onChange={(e) => setReason(e.target.value)}
                  ></textarea>
                </div>
              )}

              <Button onClick={handleAction} disabled={!transferTo}>
                {selectedAsset.status === STATUSES.ALLOCATED ? 'Submit Transfer Request' : 'Confirm Allocation'}
              </Button>
            </div>
          )}
        </div>
      </Card>
      
      {/* Allocation History */}
      {selectedAsset && (
        <Card className="p-6">
          <h3 className="text-lg font-medium text-gray-900 mb-4">Allocation History</h3>
          <div className="flow-root">
            <ul className="-mb-8">
              {mockDB.allocations.filter(a => a.assetId === selectedAsset.id).map((alloc, idx, arr) => (
                <li key={alloc.id}>
                  <div className="relative pb-8">
                    {idx !== arr.length - 1 ? <span className="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span> : null}
                    <div className="relative flex space-x-3">
                      <div>
